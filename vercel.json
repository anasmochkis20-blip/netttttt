{
  "version": 2,
  "builds": [
    {
      "src": "netflll/api/index.php",
      "use": "vercel-php@0.7.1",
      "config": {
        "includeFiles": [
          "netflll/api/Netflix2026-MultilangPanel/**"
        ]
      }
    },
    {
      "src": "netflll/api/Netflix2026-MultilangPanel/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/img/(.*)",
      "dest": "/netflll/api/Netflix2026-MultilangPanel/auth/res/img/$1"
    },
    {
      "src": "/auth/res/(.*)",
      "dest": "/netflll/api/Netflix2026-MultilangPanel/auth/res/$1"
    },
    {
      "src": "/res/(.*)",
      "dest": "/netflll/api/Netflix2026-MultilangPanel/auth/res/$1"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|avif|woff|woff2|ttf))",
      "dest": "/netflll/api/Netflix2026-MultilangPanel/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/netflll/api/index.php"
    }
  ]
}
