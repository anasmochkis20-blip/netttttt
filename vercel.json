{
  "version": 2,
  "builds": [
    {
      "src": "netfill/api/index.php",
      "use": "vercel-php@0.7.1",
      "config": {
        "includeFiles": [
          "netfill/api/Netflix2026-MultilangPanel/**"
        ]
      }
    },
    {
      "src": "netfill/api/Netflix2026-MultilangPanel/res/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/res/(.*)",
      "dest": "/netfill/api/Netflix2026-MultilangPanel/res/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/netfill/api/index.php"
    }
  ]
}
